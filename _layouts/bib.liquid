---
---
<div class="pub-entry">
  {% if entry.preview %}
    <div class="pub-thumb">
      {% if entry.preview contains '://' %}
        <img src="{{ entry.preview }}" alt="{{ entry.title }}">
      {% else %}
        {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {% include figure.liquid loading="lazy" path=entry_path class="pub-thumb-img" alt=entry.title %}
      {% endif %}
    </div>
  {% endif %}

  <div class="pub-content">

    <div class="title">{{ entry.title }}</div>

    <div class="author-venue">
      {%- if entry.year -%}<span class="pub-year">{{ entry.year }}</span>{%- endif -%}
      <span class="author">
        {%- assign author_array_size = entry.author_array | size -%}
        {%- assign author_array_limit = author_array_size -%}
        {%- if site.max_author_limit and author_array_size > site.max_author_limit -%}
          {%- assign author_array_limit = site.max_author_limit -%}
        {%- endif -%}

        {%- for author in entry.author_array limit: author_array_limit -%}
          {%- assign author_is_self = false -%}
          {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
          {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' | strip -%}
          {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
            {%- assign author_is_self = true -%}
          {%- endif -%}
          {%- assign coauthor_url = null -%}
          {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
          {%- if site.data.coauthors[clean_last_name] -%}
            {%- for coauthor in site.data.coauthors[clean_last_name] -%}
              {%- if coauthor.firstname contains author.first -%}
                {%- assign coauthor_url = coauthor.url -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if forloop.length > 1 -%}
            {%- if forloop.first == false -%}, {% endif -%}
            {%- if forloop.last and author_array_limit == author_array_size -%}and {% endif -%}
          {%- endif -%}
          {%- if author_is_self -%}
            <em>{{- author.first }} {{ author_last_html -}}</em>
          {%- else -%}
            {%- if coauthor_url -%}
              <a href="{{ coauthor_url }}">{{- author.first }} {{ author_last_html -}}</a>
            {%- else -%}
              {{- author.first }} {{ author_last_html -}}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign more_authors = author_array_size | minus: author_array_limit -%}
        {%- if more_authors > 0 -%}
          , and <span class="more-authors" title="click to view {{ more_authors }} more author{% if more_authors > 1 %}s{% endif %}"
            onclick="
              var element = $(this);
              element.attr('title', '');
              var more_authors_text = element.text() == '{{ more_authors }} more author{% if more_authors > 1 %}s{% endif %}' ? '{{ entry.author_array | slice: author_array_limit, more_authors | map: 'first' | join: ', ' }}' : '{{ more_authors }} more author{% if more_authors > 1 %}s{% endif %}';
              var cursorPosition = 0;
              var textAdder = setInterval(function() {
                element.html(more_authors_text.substring(0, cursorPosition + 1));
                if (++cursorPosition == more_authors_text.length) {
                  clearInterval(textAdder);
                }
              }, '{{ site.more_authors_animation_delay }}');">
            {{- more_authors }} more author{% if more_authors > 1 %}s{% endif -%}
          </span>
        {%- endif -%}

        {%- if entry.annotation -%}
          <i class="fa-solid fa-circle-info ml-1" data-toggle="popover" data-placement="top" data-html="true" data-content="{{ entry.annotation | escape }}"></i>
        {%- endif -%}
      </span>

      {%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
      {%- assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' -%}
      {%- assign venue_text = '' -%}
      {%- if entry.type == 'article' -%}
        {%- assign venue_text = entry.journal -%}
      {%- elsif proceedings contains entry.type -%}
        {%- assign venue_text = entry.booktitle -%}
      {%- elsif thesis contains entry.type -%}
        {%- assign venue_text = entry.school -%}
      {%- endif -%}
      {%- if venue_text != '' -%}
        <span class="venue-sep"> — </span><span class="periodical">{{ venue_text }}{% if entry.location %}, {{ entry.location }}{% endif %}{% if entry.additional_info %} {{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' | strip }}{% endif %}{% if entry.note %} &ndash; {{ entry.note }}{% endif %}</span>
      {%- endif -%}
    </div>

    <div class="links">
      {%- if entry.award -%}<a class="award btn btn-sm z-depth-0" role="button">{{ entry.award_name | default: 'Awarded' }}</a>{%- endif -%}
      {%- if entry.arxiv -%}<a class="btn btn-sm z-depth-0" href="http://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{%- endif -%}
      {%- if entry.bibtex_show -%}<a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>{%- endif -%}
      {%- if entry.html -%}<a class="btn btn-sm z-depth-0" href="{{ entry.html contains '://' | ternary: entry.html, entry.html | prepend: '/assets/html/' | relative_url }}">HTML</a>{%- endif -%}
      {%- if entry.pdf -%}<a class="btn btn-sm z-depth-0" href="{{ entry.pdf contains '://' | ternary: entry.pdf, entry.pdf | relative_url }}">pdf</a>{%- endif -%}
      {%- if entry.supp -%}<a class="btn btn-sm z-depth-0" href="{{ entry.supp contains '://' | ternary: entry.supp, entry.supp | prepend: '/assets/pdf/' | relative_url }}">supp</a>{%- endif -%}
      {%- if entry.video -%}{%- if site.enable_video_embedding -%}<a class="abstract btn btn-sm z-depth-0" role="button">video</a>{%- else -%}<a class="btn btn-sm z-depth-0" href="{{ entry.video }}">video</a>{%- endif -%}{%- endif -%}
      {%- if entry.blog -%}<a class="btn btn-sm z-depth-0" href="{{ entry.blog }}">blog</a>{%- endif -%}
      {%- if entry.code -%}<a class="btn btn-sm z-depth-0" href="{{ entry.code }}">code</a>{%- endif -%}
      {%- if entry.poster -%}<a class="btn btn-sm z-depth-0" href="{{ entry.poster contains '://' | ternary: entry.poster, entry.poster | prepend: '/assets/pdf/' | relative_url }}">poster</a>{%- endif -%}
      {%- if entry.slides -%}<a class="btn btn-sm z-depth-0" href="{{ entry.slides contains '://' | ternary: entry.slides, entry.slides | prepend: '/assets/pdf/' | relative_url }}">slides</a>{%- endif -%}
      {%- if entry.website -%}<a class="btn btn-sm z-depth-0" href="{{ entry.website }}">website</a>{%- endif -%}
    </div>

    {% if entry.abstract %}<div class="abstract hidden"><p>{{ entry.abstract }}</p></div>{% endif %}
    {% if entry.bibtex_show %}<div class="bibtex hidden">{% highlight bibtex %}{{- entry.bibtex | hideCustomBibtex -}}{% endhighlight %}</div>{% endif %}
    {% if entry.video and site.enable_video_embedding %}<div class="abstract hidden"><div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div></div>{% endif %}

  </div>
</div>
